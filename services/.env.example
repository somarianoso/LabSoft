# Use a URL privada do PostgreSQL no Render; não comite valores reais.
DATABASE_URL=postgresql://user:password@host:5432/wellflix
# Gere um segredo aleatório com pelo menos 32 bytes e use o mesmo valor nos 4 serviços.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Domínio HTTPS do Static Site do React no Render.
FRONTEND_ORIGIN=https://wellflix-frontend.onrender.com
