DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
FRONTEND_ORIGIN=http://localhost:5173
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Integração entre serviços -------------------------------------------------
# Cada serviço usa só o próprio schema (identidade, conta, profissionais,
# catalogo). DB_SCHEMA só é necessário para trocar esse nome.
# DB_SCHEMA=

# Kafka (eventos em tempo real que alimentam as réplicas locais).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Para Kafka gerenciado (Confluent Cloud, Aiven...):
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_TOPIC_REPLICATION=3       # sem ela, usa o padrão do broker
# Certificados como texto (ex.: Aiven: ca.pem, service.cert, service.key).
# Com certificado de cliente use KAFKA_SECURITY_PROTOCOL=SSL.
# KAFKA_SSL_CA_PEM=
# KAFKA_SSL_CERT_PEM=
# KAFKA_SSL_KEY_PEM=

# Endereços dos outros serviços (chamadas REST). Locais por padrão.
# IDENTIDADE_API_URL=http://localhost:8001
# CONTA_API_URL=http://localhost:8002
# PROFISSIONAIS_API_URL=http://localhost:8003
# CATALOGO_API_URL=http://localhost:8004
# SERVICE_TIMEOUT_SECONDS=30

# Operacional ----------------------------------------------------------------
# MIGRAR_AO_INICIAR=1              # 0 desliga a migração automática na subida
# HEARTBEAT_INTERVALO_SEGUNDOS=30  # heartbeat no tópico wellflix.operacional.heartbeat
# LOG_LEVEL=INFO
